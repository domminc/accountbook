# PostgreSQL 연결 문자열 (Supabase: 프로젝트 > Connect > Session pooler)
DATABASE_URL=postgres://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 로그인 세션 서명 키 (32자 이상 아무 문자열). 예: openssl rand -base64 48
SESSION_SECRET=

# 구글·카카오 로그인용 (지금은 쓰지 않음, src/lib/supabase/README.md 참고)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 안드로이드 앱(Google Play, TWA) 연결: /.well-known/assetlinks.json 에 들어간다. docs/DEPLOY.md "안드로이드 앱" 참고
# ANDROID_PACKAGE_NAME=kr.co.homesell.accountbook
# ANDROID_SHA256_FINGERPRINTS=AA:BB:...(업로드 키),CC:DD:...(Play 앱 서명 키)
